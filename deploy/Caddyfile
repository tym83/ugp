# Caddy автоматически получает и продлевает TLS-сертификаты Let's Encrypt.
# Требуется: A-запись {$DOMAIN} (и www.{$DOMAIN}) указывает на IP этого сервера,
# порты 80/443 открыты.
{$DOMAIN} {
	encode gzip zstd
	reverse_proxy app:3000
}

# www → редирект на апекс (работает, если для www.{$DOMAIN} тоже есть DNS-запись).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
