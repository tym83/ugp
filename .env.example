# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the Underground Grappling Platform.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Database connection string (Prisma).
# Local dev / CI — SQLite (this is the default the app ships with):
DATABASE_URL="file:./dev.db"
#
# Production — PostgreSQL (reg.ru, data hosted in RF per 152-FZ).
# Switch datasource provider to "postgresql" in prisma/schema.prisma first.
# DATABASE_URL="postgresql://ugp:CHANGE_ME@db-host:5432/ugp?schema=public&sslmode=require"

# Secret used to sign session cookies (HMAC-SHA256).
# Minimum 16 characters. REQUIRED in production — the app throws on startup
# without it (src/lib/auth/session.ts). Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="dev-insecure-session-secret-change-me"

# Runtime environment: development | production | test
NODE_ENV="development"
