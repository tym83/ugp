# Прод-переменные (генерируются автоматически deploy/bootstrap.sh; этот файл — референс).
# НИКОГДА не коммитить реальный .env (он в .gitignore).

# Домен, на котором Caddy выпустит TLS (A-запись должна указывать на этот сервер).
DOMAIN=app.grappling74.ru

# PostgreSQL (в контейнере db).
POSTGRES_USER=ugp
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=ugp

# Строка подключения приложения к БД (хост db — имя сервиса в compose).
DATABASE_URL=postgresql://ugp:change-me-long-random@db:5432/ugp?schema=public

# Подпись сессий (мин. 16 символов; в проде обязателен). openssl rand -base64 48
SESSION_SECRET=change-me-long-random-secret

# Первичный сид (profile tools) создаёт демо-аккаунты (пароль demo) на пустой БД:
# admin@ / org@ / coach@ / ref@ / athlete@ugp.local. Отдельные ADMIN_* не нужны.
